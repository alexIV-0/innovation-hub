# --- Database -------------------------------------------------------------
# Either set the discrete PG* variables...
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432
PGDATABASE=
# ...or use a single connection string instead:
# DB_CONNECTION_STRING=postgres://user:pass@host:5432/db?sslmode=require

# Optional pool tuning
# PG_POOL_MAX=3
# PG_POOL_IDLE_MS=10000
# PG_POOL_CONN_MS=30000   # raise for slow remote hosts (default 30s when PGHOST is not localhost)

# Optional TLS
# PGSSLMODE=require            # disable | no-verify | require | verify-ca | verify-full
# PGSSLROOTCERT=/path/root.crt
# PGSSL_CA="-----BEGIN CERTIFICATE-----\n..."
# PGSSL_REJECT_UNAUTHORIZED=1

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Bootstrapped on `pnpm db:init` (also creates / promotes this user to ADMIN)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME="Platform Admin"

# --- S3 (or S3-compatible: Nebius / Cloudflare R2 / MinIO / etc.) ---------
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=                # leave empty for AWS S3
AWS_S3_PREFIX=innohub            # logical "folder" — also enforced by /api/media

# Credentials. Any of the following name pairs is accepted:
S3_KEY_ID=
S3_SECRET_KEY=
# AWS_KEY_ID= / AWS_SECRET_KEY=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=

# Optional public CDN base for serving uploaded media directly:
# NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Public site URL for links in Asana (not localhost). On Vercel, VERCEL_URL is used if unset.
# APP_PUBLIC_URL=https://innohub.example.com

# Presigned S3 GET TTL (seconds) for Asana attachments when APP_PUBLIC_URL is unset (default 7 days).
# FEATURE_SUGGESTION_PRESIGN_SEC=604800

# Optional upload size cap (bytes). Default 250 MB.
# ADMIN_UPLOAD_MAX_BYTES=262144000

# --- Public site (contact + video order links in Asana) ---------------------
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/your_handle
# APP_PUBLIC_URL=https://innohub.example.com

# --- Asana (feature suggestions + video orders) -----------------------------
# 1. Create a free account at https://asana.com and a project (e.g. "Feature Suggestions").
# 2. Personal Access Token: https://app.asana.com/0/my-apps -> Create new token.
# 3. Workspace GID: GET https://app.asana.com/api/1.0/workspaces
#    Header: Authorization: Bearer <ASANA_ACCESS_TOKEN>
# 4. Project GID: GET https://app.asana.com/api/1.0/workspaces/<workspace_gid>/projects
#    Or copy from the project URL: https://app.asana.com/0/<project_gid>/list
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=
ASANA_PROJECT_GID=
ASANA_DEFAULT_SECTION_GID=
# ASANA_DEFAULT_ASSIGNEE_GID=
# Optional separate project for /video/[id] order form (defaults to ASANA_PROJECT_GID)
# ASANA_VIDEO_ORDERS_PROJECT_GID=
# ASANA_VIDEO_ORDERS_SECTION_GID=
# FEATURE_SUGGESTION_MAX_FILES=5
# FEATURE_SUGGESTION_UPLOAD_MAX_BYTES=26214400
